+@contextmanager
+def acl_compatible_temporary_directory(prefix: str) -> Iterator[str]:
+    """Use an inherited Windows ACL so nested Codex can enter its test workspace."""
+    if os.name != "nt":
+        with tempfile.TemporaryDirectory(prefix=prefix) as temporary:
+            yield temporary
+        return
+    base = Path(os.environ.get("GPT_INSTRUCT_EVAL_ROOT") or tempfile.gettempdir()).resolve()
+    if not base.is_dir() or base.is_symlink():
+        raise RuntimeError("evaluation root must be an existing real directory")
+    temporary = (base / f"{prefix}{uuid.uuid4().hex}").resolve()
+    if not temporary.is_relative_to(base):
+        raise RuntimeError("evaluation directory escaped its root")
+    temporary.mkdir()
+    try:
+        yield str(temporary)
+    finally:
+        shutil.rmtree(temporary)
 
